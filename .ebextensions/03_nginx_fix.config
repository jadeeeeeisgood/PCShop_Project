files:
  "/tmp/nginx_placeholder.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Placeholder file to prevent nginx config issues
      # This file ensures .ebextensions processes correctly
      
container_commands:
  01_remove_problematic_ssl_config:
    command: "rm -f /var/proxy/staging/nginx/conf.d/https.conf"
    ignoreErrors: true
  02_cleanup_nginx_configs:
    command: "rm -f /var/proxy/staging/nginx/conf.d/https.conf /var/proxy/staging/nginx/conf.d/ssl.conf"
    ignoreErrors: true