option_settings:
  aws:elasticbeanstalk:container:php:phpini:
    document_root: /public
    memory_limit: 512M
    max_execution_time: 300
  aws:elasticbeanstalk:application:environment:
    APP_ENV: production
    APP_DEBUG: false
    LOG_CHANNEL: stderr

files:
  "/etc/php.d/project.ini":
    mode: "000644"
    owner: root
    group: root
    content: |
      upload_max_filesize = 64M
      post_max_size = 64M
      max_input_time = 300
  "/var/app/staging/public/test.php":
    mode: "000644"
    owner: webapp
    group: webapp
    content: |
      <?php
      echo "PHP is working!<br>";
      echo "Document root: " . $_SERVER['DOCUMENT_ROOT'] . "<br>";
      echo "Script name: " . $_SERVER['SCRIPT_NAME'] . "<br>";
      echo "Request URI: " . $_SERVER['REQUEST_URI'] . "<br>";
      if (file_exists('../storage')) echo "Storage dir exists<br>";
      if (file_exists('index.php')) echo "index.php exists<br>";
      if (file_exists('../bootstrap/cache')) echo "Bootstrap cache exists<br>";

container_commands:
  00_create_bootstrap_cache:
    command: |
      mkdir -p /var/app/staging/bootstrap/cache
      chmod 755 /var/app/staging/bootstrap/cache
      chown webapp:webapp /var/app/staging/bootstrap/cache
      touch /var/app/staging/bootstrap/cache/.gitkeep
      echo "Bootstrap cache directory created before composer"
  01_create_storage_dirs:
    command: |
      mkdir -p /var/app/staging/storage/{logs,framework/{cache,sessions,views},app/public}
      chmod -R 755 /var/app/staging/storage
      chown -R webapp:webapp /var/app/staging/storage
      if [ -f /var/app/staging/.env.aws ]; then
        cp /var/app/staging/.env.aws /var/app/staging/.env
        chown webapp:webapp /var/app/staging/.env
        chmod 644 /var/app/staging/.env
      fi