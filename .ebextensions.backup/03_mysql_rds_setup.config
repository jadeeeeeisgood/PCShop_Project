container_commands:
  01_set_permissions:
    command: "chown -R webapp:webapp /var/app/ondeck/storage /var/app/ondeck/bootstrap/cache"
  02_chmod_storage:
    command: "chmod -R 775 /var/app/ondeck/storage /var/app/ondeck/bootstrap/cache"
  03_test_rds:
    command: "php artisan tinker --execute=\"echo 'Testing RDS connection...' . chr(10); try { \\DB::connection()->getPdo(); echo 'RDS connection successful!' . chr(10); } catch(Exception \\$e) { echo 'RDS connection failed: ' . \\$e->getMessage() . chr(10); }\""
    leader_only: true
  04_migrate:
    command: "php artisan migrate --force"
    leader_only: true
  05_seed_check:
    command: 'if [ $(php artisan tinker --execute="echo \App\Models\Product::count();" 2>/dev/null | tail -1) = "0" ]; then php artisan db:seed --class=ProductionSeeder --force; fi'
    leader_only: true
  06_optimize:
    command: "php artisan optimize:clear"
  07_config_cache:
    command: "php artisan config:cache"
  08_route_cache:
    command: "php artisan route:cache"
    
option_settings:
  aws:elasticbeanstalk:application:environment:
    COMPOSER_HOME: /root